# Copy this file to .env and set values in the deployment environment.
# Do not commit secrets to source control.

# Azure APIM-backed backend configuration
AZURE_COSMOS_API_BASE_URL=https://emtech-apim-all-all-poc.azure-api.net/cosmos/docs
AZURE_COSMOS_SUBSCRIPTION_KEY=<set-at-deployment-time>
AZURE_COSMOS_DATABASE_NAME=medinspect-app-db
AZURE_COSMOS_RESULTS_DATABASE_NAME=medinspect-results-db
AZURE_STORAGE_API_BASE_URL=https://emtech-apim-all-all-poc.azure-api.net/storage/hackathon/{custom_folder_name}/{file_name}
AZURE_STORAGE_SUBSCRIPTION_KEY=<set-at-deployment-time>
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_PREFIX=medinspect
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
