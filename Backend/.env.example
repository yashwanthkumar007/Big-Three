# Copy this file to .env and set values in the deployment environment.
# Do not commit secrets to source control.

AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE_NAME=medinspect-db
AZURE_COSMOS_ACCOUNT_KEY=<set-at-deployment-time-if-using-key-based-auth>
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
AZURE_STORAGE_ACCOUNT_KEY=<set-at-deployment-time-if-using-key-based-auth>
AZURE_STORAGE_CONTAINER_PREFIX=medinspect
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
